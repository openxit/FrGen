<Window x:Class="OpenFrameGen.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrGen Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Border x:Name="HudRoot"
            Background="#CC0D0F13"
            BorderBrush="#55323B4D"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,9"
            Margin="16">
        <StackPanel MinWidth="210">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="FRGEN"
                           FontFamily="Consolas"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#8C96A8"
                           VerticalAlignment="Center" />
                <Border x:Name="StatusBadge"
                        Grid.Column="1"
                        Background="#221F3B2B"
                        BorderBrush="#4422C55E"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1">
                    <TextBlock x:Name="StatusText"
                               Text="STANDBY"
                               FontFamily="Consolas"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="#22C55E" />
                </Border>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OUTPUT"
                               FontFamily="Consolas"
                               FontSize="9.5"
                               Foreground="#6E7889" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="TotalFpsText"
                                   Text="0"
                                   FontFamily="Consolas"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#E6EAF2" />
                        <TextBlock Text=" FPS"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#8C96A8"
                                   Margin="2,0,0,4"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="BASE (NO FG)"
                               FontFamily="Consolas"
                               FontSize="9.5"
                               Foreground="#6E7889"
                               HorizontalAlignment="Right" />
                    <TextBlock x:Name="BaseFpsText"
                               Text="0 FPS"
                               FontFamily="Consolas"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#93C5FD"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#332A3140" Margin="0,0,0,6" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SplitText"
                           Text="0 Real · 0 Gen"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#CBD5E1" />
                <TextBlock x:Name="TimingText"
                           Grid.Column="1"
                           Text="0.0 ms"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#8C96A8"
                           Margin="12,0,0,0" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
