<Window x:Class="OpenFrameGen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrGen"
        Width="780"
        Height="560"
        MinWidth="720"
        MinHeight="520"
        Background="#0D0F13"
        Foreground="#E6EAF2"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FRGEN"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#F1F5F9" />
                    <Border Background="#182234"
                            BorderBrush="#293B5F"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.1.0 · OPEN SOURCE"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="#60A5FA" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="GpuInfoText"
                           Text="GPU: Initialisiere Direct3D 11..."
                           FontSize="12"
                           Foreground="#8C96A8"
                           Margin="0,3,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ToggleBtn"
                        Style="{StaticResource PrimaryButton}"
                        Content="Frame-Gen starten (Ctrl+Alt+F)"
                        Click="ToggleBtn_Click"
                        MinWidth="210" />
            </StackPanel>
        </Grid>

        <!-- Main 2-Column Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Pipeline & Overlay Controls -->
            <StackPanel Grid.Column="0">
                <!-- Target & FrameGen Card -->
                <Border Background="#141820"
                        BorderBrush="#242A36"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="FRAME-GENERATION &amp; ZIELFENSTER"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8C96A8"
                                   Margin="0,0,0,10" />

                        <TextBlock Text="Zielfenster / Spiel" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowCombo"
                                      Height="32"
                                      Background="#0D0F13"
                                      Foreground="#0D0F13"
                                      BorderBrush="#2A3140" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource FlatButton}"
                                    Content="Aktualisieren"
                                    Padding="10,6"
                                    Click="RefreshWindows_Click" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Multiplikator" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="MultiplierCombo"
                                          Height="30"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="Off (Passthrough)" Tag="1" />
                                    <ComboBoxItem Content="2x (Doppelte FPS)" Tag="2" IsSelected="True" />
                                    <ComboBoxItem Content="3x (Dreifache FPS)" Tag="3" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Optical Flow Qualität" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="QualityCombo"
                                          Height="30"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="Fast (GTX / Handheld)" Tag="Fast" />
                                    <ComboBoxItem Content="Balanced" Tag="Balanced" IsSelected="True" />
                                    <ComboBoxItem Content="High" Tag="High" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Upscaling / Nachschärfung" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                        <ComboBox x:Name="UpscaleCombo"
                                  Height="30"
                                  SelectionChanged="SettingsChanged">
                            <ComboBoxItem Content="Off (Nativ)" Tag="Off" />
                            <ComboBoxItem Content="Sharp CAS (Contrast Adaptive)" Tag="SharpCas" IsSelected="True" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Overlay Settings Card -->
                <Border Background="#141820"
                        BorderBrush="#242A36"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="IN-GAME OVERLAY (KLICK-DURCHLÄSSIG)"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8C96A8"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="OverlayCheck"
                                      Content="Aktiv (Ctrl+Alt+O)"
                                      Foreground="#E6EAF2"
                                      IsChecked="True"
                                      HorizontalAlignment="Right"
                                      Checked="OverlayConfigChanged"
                                      Unchecked="OverlayConfigChanged" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Position" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4" />
                                <ComboBox x:Name="OverlayCornerCombo"
                                          Height="30"
                                          SelectionChanged="OverlayConfigChanged">
                                    <ComboBoxItem Content="Oben Links" Tag="TopLeft" IsSelected="True" />
                                    <ComboBoxItem Content="Oben Rechts" Tag="TopRight" />
                                    <ComboBoxItem Content="Unten Links" Tag="BottomLeft" />
                                    <ComboBoxItem Content="Unten Rechts" Tag="BottomRight" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="OpacityLabel"
                                           Text="Transparenz (86%)"
                                           FontSize="12"
                                           Foreground="#CBD5E1"
                                           Margin="0,0,0,8" />
                                <Slider x:Name="OpacitySlider"
                                        Minimum="0.30"
                                        Maximum="1.0"
                                        Value="0.86"
                                        ValueChanged="OpacitySlider_ValueChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: Live Telemetry & GitHub Driver Manager -->
            <StackPanel Grid.Column="2">
                <!-- Telemetry Card -->
                <Border Background="#141820"
                        BorderBrush="#242A36"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LIVE TELEMETRIE"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8C96A8"
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OHNE FG (REAL)" FontFamily="Consolas" FontSize="10" Foreground="#6E7889" />
                                <TextBlock x:Name="BaseFpsLabel"
                                           Text="0.0 FPS"
                                           FontFamily="Consolas"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#93C5FD" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="AKTUELL (OUTPUT)" FontFamily="Consolas" FontSize="10" Foreground="#6E7889" />
                                <TextBlock x:Name="TotalFpsLabel"
                                           Text="0.0 FPS"
                                           FontFamily="Consolas"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#22C55E" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="#242A36" Margin="0,2,0,8" />

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Real / Generiert:" FontSize="12" Foreground="#8C96A8" />
                            <TextBlock x:Name="RealGenLabel"
                                       Text="0.0 Real · 0.0 Gen"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#E6EAF2"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Frame-Time / OF:" FontSize="12" Foreground="#8C96A8" />
                            <TextBlock x:Name="TimingLabel"
                                       Text="0.0 ms · 0.0 ms"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#E6EAF2"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GitHub Driver Layer Card -->
                <Border Background="#141820"
                        BorderBrush="#242A36"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="VULKAN / DXGI TREIBER-LAYER"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#8C96A8"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Lädt den nativen C++ Vulkan Implicit Layer direkt aus dem GitHub Release (openxit/FrGen), damit die .exe klein bleibt."
                                   FontSize="11.5"
                                   Foreground="#8C96A8"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <Border Background="#0D0F13"
                                BorderBrush="#242A36"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="DriverStatusText"
                                           Text="Status: Nicht installiert"
                                           FontFamily="Consolas"
                                           FontSize="11.5"
                                           Foreground="#CBD5E1" />
                                <TextBlock x:Name="DriverPathText"
                                           Text="%LocalAppData%\FrGen\driver"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="#6E7889"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <ProgressBar x:Name="DriverProgress"
                                     Height="5"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Visibility="Collapsed"
                                     Margin="0,0,0,8" />

                        <Button x:Name="InstallDriverBtn"
                                Style="{StaticResource FlatButton}"
                                Content="Treiber von GitHub installieren"
                                Click="InstallDriverBtn_Click"
                                Margin="0,0,0,6" />
                        <Button x:Name="UninstallDriverBtn"
                                Style="{StaticResource FlatButton}"
                                Content="Treiber entfernen"
                                Click="UninstallDriverBtn_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="FooterStatusText"
                       Text="Bereit · Shader Status: Wird geprüft..."
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="#6E7889"
                       VerticalAlignment="Center" />
            <TextBlock Text="Hotkeys: Ctrl+Alt+F (FG) · Ctrl+Alt+O (Overlay)"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="#6E7889"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
